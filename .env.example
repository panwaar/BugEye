# Required
GROQ_API_KEY=your_groq_api_key

# Optional — only needed for PR review (raises GitHub API limits; public repos work without it)
GITHUB_TOKEN=

# Optional — if set, the web UI and API require this token (recommended for public deployments)
ACCESS_TOKEN=

# Optional tuning (defaults shown)
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLONE_TIMEOUT=120
MAX_FILES=500
MAX_FILE_BYTES=200000
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
MAX_CONTEXT_CHARS=8000
MAX_PR_DIFF_CHARS=8000
MAX_INDEXED_REPOS=5
REVIEW_LIMIT_PER_HOUR=10
CHAT_LIMIT_PER_HOUR=60
MAX_CONCURRENT_REVIEWS=2
PROXY_HOPS=1
PORT=7860
